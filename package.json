{
  "name": "layer-kit",
  "version": "0.1.0",
  "description": "A modern UI overlay and layout toolkit for React",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "files": [
    "dist"
  ],
  "keywords": [
    "ui",
    "overlay",
    "modal",
    "react",
    "layer",
    "component-library"
  ],
